# ============================================================
# .env.example — All environment variables used in this project
# Copy this file to .env and fill in your real values.
# NEVER commit .env to GitHub. It is already in .gitignore.
# ============================================================

# ── Node.js Backend (Server.js) ─────────────────────────────
# The URL of the Python OCR/AI microservice.
# Local dev: http://127.0.0.1:8000
# Cloud: https://coal-mine-ocr.onrender.com (set automatically by render.yaml)
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# The public-facing URL of this Node.js server itself.
# Used for generating clickable photo links in console logs.
# Local dev: http://localhost:5000
# Cloud: https://coal-mine-hq.onrender.com
SERVER_HOST=http://localhost:5000

# PORT is set automatically by Render. Only set this for local overrides.
# PORT=5000

# ── Python OCR Microservice (ocr_service/) ──────────────────
# Your Groq API key for the Llama-3.1 AI compliance engine.
# Get one free at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Your Google Gemini API key for the OCR document digitizer.
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Expo Mobile App (App.js + syncEngine.js) ────────────────
# Full base URL of the deployed Node.js backend.
# Local dev (on same Wi-Fi as laptop): http://192.168.x.x:5000
# Cloud: https://coal-mine-hq.onrender.com
EXPO_PUBLIC_SERVER_URL=http://192.168.x.x:5000
